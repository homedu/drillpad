{
    "name": "web_quiz",
    "dependencies": {
        "@wangeditor-next/editor": "^6.7.0",
        "@wangeditor-next/editor-for-react": "^6.7.0",
        "service_net": "workspace:*",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.5",
        "concurrently": "^10.0.7",
        "tailwindcss": "^4.3.5"
    },
    "scripts": {
        "dev": "concurrently \"bun dev:css\" \"bun dev:server\" \"bun dev:upload\"",
        "dev:server": "bun --hot --port 3000 index.html",
        "dev:css": "bun tailwindcss -i ./global.css -o ./dist.css --watch=always",
        "dev:upload": "bun ../service_upload/svr-upload.js",
        "build:html": "bun build index.html --outdir ./dist --define QDP_IP='\"192.168.1.159\"'",
        "build:css": "bun tailwindcss -i ./global.css -o ./dist.css --minify",
        "build:upload": "bun build ../service_upload/svr-upload.js --compile --target=bun-linux-x64 --outfile svr-upload --define QDP_IP='\"192.168.1.159\"'",
        "build": "bun build:css && bun build:html && bun build:upload"
    }
}